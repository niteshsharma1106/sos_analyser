# .env.example — copy to .env and fill in ONE provider block.
# Model, provider, and API key are read ONLY from this file (no hardcoded defaults).

# Required for LLM chat/analyze:
#   OSP_SOS_MODEL
#   OSP_SOS_MODEL_PROVIDER
#   + the matching provider API key (or OSP_SOS_API_KEY)

# --- Google Gemini ---
GOOGLE_API_KEY=your-gemini-api-key-here
OSP_SOS_MODEL=gemini-2.5-pro
OSP_SOS_MODEL_PROVIDER=google_genai

# --- Or Groq (comment Google block above, uncomment this) ---
# GROQ_API_KEY=your-groq-api-key-here
# OSP_SOS_MODEL=groq/compound-mini
# OSP_SOS_MODEL_PROVIDER=groq
# Other Groq examples: llama-3.3-70b-versatile, openai/gpt-oss-120b

# --- Or OpenAI ---
# OPENAI_API_KEY=your-openai-api-key-here
# OSP_SOS_MODEL=gpt-4o-mini
# OSP_SOS_MODEL_PROVIDER=openai

# --- Or local Ollama (no API key needed) ---
# OSP_SOS_MODEL=llama3.2
# OSP_SOS_MODEL_PROVIDER=ollama
# Install the LangChain adapter too: pip install langchain-ollama
# Optional only for an authenticated/proxied Ollama endpoint:
# OLLAMA_API_KEY=your-api-key-here

# Optional: unified API key alias (copied onto the provider key above when unset)
# OSP_SOS_API_KEY=your-api-key-here

# Optional: explicit path to .env if not in the repo root / CWD
# OSP_SOS_DOTENV=D:\path\to\.env

# Optional logging
# OSP_SOS_LOG_LEVEL=INFO
# OSP_SOS_LOG_FILE=osp_sos.log

# TLS: by default the app uses the OS/Windows trust store (corporate roots).
# OSP_SOS_USE_SYSTEM_CERTS=1
# Optional explicit corporate CA PEM if system trust is not enough:
# OSP_SOS_CA_BUNDLE=C:\path\to\company-root-ca.pem

# LLM investigation redacts common passwords, API keys, bearer credentials,
# and private-key blocks before evidence is sent to the provider or logged.
